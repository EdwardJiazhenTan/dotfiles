// Zed settings
// configured by Edward J Tan
{
  // the bar to show the open buffers.
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  // the bar on the very top with close, minimize and fullscreen buttons
  "title_bar": {
    "show_menus": false,
    "show_project_items": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_branch_icon": false,
    "show_branch_name": false,
  },
  "search": {
    "button": false,
  },
  "terminal": {
    "button": true,
    "dock": "right",
  },
  // bottom bar
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": true,
  },

  // file exporer tree on left
  "project_panel": {
    "button": true,
    "hide_root": true,
    "default_width": 300,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-3-7-sonnet-thinking-latest",
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-latest",
    },
    "dock": "right",
  },
  "git_panel": {
    "dock": "left",
  },
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": false,
    "show_other_hints": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": true,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false,
    },
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
  },
  "tabs": {
    "show_diagnostics": "errors",
    "git_status": true,
    "file_icons": true,
  },
  "git": { "inline_blame": { "enabled": false } },
  "telemetry": {
    "metrics": false,
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "icon_theme": "Catppuccin Macchiato",
  "ui_font_size": 17,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Nordic Syntax",
  },
  "show_edit_predictions": false,
  "cursor_blink": false,
  "always_treat_brackets_as_autoclosed": true,
  "file_finder": {
    "file_icons": true,
    "modal_max_width": "small",
  },
  "colorize_brackets": true,
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
}
