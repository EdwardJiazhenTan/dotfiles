{
  "actions" : [
    {
      "actions" : [
        {
          "key" : "m",
          "label" : "Spotify",
          "type" : "application",
          "value" : "/Applications/Spotify.app"
        },
        {
          "iconPath" : "/Applications/kitty.app",
          "key" : "t",
          "label" : "kitty",
          "type" : "command",
          "value" : "/Applications/kitty.app/Contents/MacOS/kitty --single-instance -d ~"
        },
        {
          "key" : "b",
          "label" : "Zen Browser",
          "type" : "application",
          "value" : "/Applications/Zen.app"
        },
        {
          "key" : "e",
          "label" : "Finder",
          "type" : "application",
          "value" : "/System/Library/CoreServices/Finder.app"
        },
        {
          "key" : "g",
          "label" : "Google Chrome",
          "type" : "application",
          "value" : "/Applications/Google Chrome.app"
        },
        {
          "key" : "w",
          "label" : "Wechat",
          "type" : "application",
          "value" : "/Applications/WeChat.app"
        },
        {
          "key" : "o",
          "label" : "OBS",
          "type" : "application",
          "value" : "/Applications/OBS.app"
        },
        {
          "key" : "c",
          "label" : "Calendar",
          "type" : "application",
          "value" : "/System/Applications/Calendar.app"
        },
        {
          "key" : "z",
          "label" : "Zed",
          "type" : "application",
          "value" : "/Applications/Zed.app"
        },
        {
          "key" : "y",
          "label" : "Youtube",
          "type" : "application",
          "value" : "/Applications/YouTube.app"
        }
      ],
      "iconPath" : "questionmark.folder.fill",
      "key" : "o",
      "label" : "Open Application",
      "type" : "group"
    },
    {
      "actions" : [
        {
          "key" : "s",
          "label" : "Selection",
          "type" : "command",
          "value" : "/usr/sbin/screencapture -i ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"
        },
        {
          "key" : "w",
          "label" : "Window",
          "type" : "command",
          "value" : "/usr/sbin/screencapture -i -w ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"
        },
        {
          "key" : "f",
          "label" : "Fullscreen",
          "type" : "command",
          "value" : "/usr/sbin/screencapture ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"
        },
        {
          "key" : "c",
          "label" : "Clipboard",
          "type" : "command",
          "value" : "/usr/sbin/screencapture -i -c"
        },
        {
          "key" : "t",
          "label" : "Touch Bar",
          "type" : "command",
          "value" : "/usr/sbin/screencapture -b ~/Pictures/Screenshots/touchbar-$(date +%Y%m%d-%H%M%S).png"
        }
      ],
      "key" : "s",
      "label" : "Screenshot",
      "type" : "group"
    },
    {
      "actions" : [
        {
          "key" : "u",
          "label" : "Update & Upgrade",
          "type" : "command",
          "value" : "open -a kitty --args sh -c '/opt/homebrew/bin/brew update && /opt/homebrew/bin/brew upgrade && echo && echo \"Press ENTER to close...\" && read'"
        },
        {
          "key" : "l",
          "label" : "List Packages",
          "type" : "command",
          "value" : "open -a kitty --args sh -c '/opt/homebrew/bin/brew list && echo && echo \"Press ENTER to close...\" && read'"
        },
        {
          "key" : "s",
          "label" : "Search Package",
          "type" : "command",
          "value" : "open -a kitty --args sh -c 'echo \"Enter package name to search:\" && read pkg && /opt/homebrew/bin/brew search \"$pkg\" && echo && echo \"Press ENTER to close...\" && read'"
        },
        {
          "key" : "i",
          "label" : "Package Info",
          "type" : "command",
          "value" : "open -a kitty --args sh -c 'echo \"Enter package name for info:\" && read pkg && /opt/homebrew/bin/brew info \"$pkg\" && echo && echo \"Press ENTER to close...\" && read'"
        }
      ],
      "key" : "b",
      "label" : "Brew",
      "type" : "group"
    },
    {
      "actions" : [
        {
          "key" : "s",
          "label" : "Sketchybar",
          "type" : "command",
          "value" : "/opt/homebrew/bin/sketchybar --reload"
        },
        {
          "key" : "l",
          "label" : "LeaderKey",
          "type" : "command",
          "value" : "killall LeaderKey && open -a LeaderKey"
        }
      ],
      "iconPath" : "bookmark.fill",
      "key" : "c",
      "label" : "Configs",
      "type" : "group"
    },
    {
      "actions" : [
        {
          "key" : "q",
          "label" : "Close Window",
          "type" : "command",
          "value" : "osascript -e 'tell application \"System Events\" to keystroke \"w\" using command down'"
        }
      ],
      "iconPath" : "rectangle.portrait.and.arrow.right",
      "key" : "q",
      "label" : "Quit",
      "type" : "group"
    }
  ],
  "type" : "group"
}
