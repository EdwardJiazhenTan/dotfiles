#!/bin/sh
# Mirror the most recent tmux paste buffer into the system clipboard.
# Invoked from the pane-set-clipboard hook so OSC 52 writes by applications
# (pi's fullscreen drag-select, nvim, etc.) reach the real clipboard.

if command -v pbcopy >/dev/null 2>&1; then
    exec tmux save-buffer - | pbcopy
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    exec tmux save-buffer - | wl-copy
fi

if command -v xclip >/dev/null 2>&1; then
    exec tmux save-buffer - | xclip -selection clipboard
fi

exit 0
